// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AI-17 — guide markup is byte-identical across the extraction > renders the English guide exactly as it shipped 1`] = `"<div lang="en" dir="ltr" class="min-w-0 space-y-3 text-start"><div class="text-sm leading-relaxed" style="color:var(--arbor-ink-soft)" role="note"><p class="font-bold">Pilot guide</p><p>Practical ideas to try gently. These pilot guides have not had individual clinical review. Adapt them to your child; pause if a step adds distress.</p></div><p class="text-xs" style="color:var(--arbor-muted)">Written for ages <bdi>2-5</bdi> years</p><div class="min-w-0 rounded-xl p-4" style="background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.doNow</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">Lower your voice, reduce words, and stay close without crowding.</p></div><div class="min-w-0 rounded-xl p-4" style="background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.sayThis</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">I&#x27;m here. We can pause. We&#x27;ll talk when things feel calmer.</p><p class="mt-2 text-xs leading-relaxed" style="color:var(--arbor-ink-soft)">Use words that fit your family. Only promise a return time you can keep.</p></div><div class="min-w-0 rounded-xl p-4" style="background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.avoid</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">Do not reason, threaten, or demand an apology mid-storm.</p></div><div class="min-w-0 rounded-xl p-4" style="background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.observe</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">Notice what happened just before and what helped recovery begin.</p></div><div class="min-w-0 rounded-xl p-4" role="note" data-testid="hard-moment-escalation" style="background:var(--arbor-green-soft);border:1px solid var(--arbor-rule-strong);border-inline-start:3px solid var(--arbor-green-ink)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.escalation</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">If anyone is in immediate danger, seek local emergency help. If these moments are getting harder to manage, lead to injury, or worry you, share what happens before and after them with your pediatrician. You do not need to wait for a set number of episodes.</p></div><details class="min-w-0 text-sm" style="color:var(--arbor-ink-soft)"><summary class="min-h-11 cursor-pointer py-3 font-semibold">Sources behind this guide</summary><ul class="space-y-1"><li><a href="https://www.healthychildren.org/English/family-life/family-dynamics/communication-discipline/Pages/Disciplining-Your-Child.aspx" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 max-w-full items-center break-all py-2 underline">www.healthychildren.org</a></li></ul></details></div>"`;

exports[`AI-17 — guide markup is byte-identical across the extraction > renders the Hebrew guide exactly as it shipped 1`] = `"<div lang="he" dir="rtl" class="min-w-0 space-y-3 text-start"><div class="text-sm leading-relaxed" style="color:var(--arbor-ink-soft)" role="note"><p class="font-bold">מדריך בפיילוט</p><p>רעיונות מעשיים שאפשר לנסות בעדינות. מדריכי הפיילוט לא עברו בדיקה קלינית פרטנית. התאימו אותם לילד או לילדה; אם צעד מגביר מצוקה, עצרו.</p></div><p class="text-xs" style="color:var(--arbor-muted)">נכתב לגילי <bdi>2-5</bdi> שנים</p><div class="min-w-0 rounded-xl p-4" style="background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.doNow</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">הנמיכו את הקול, צמצמו מילים והישארו קרובים בלי להצטופף.</p></div><div class="min-w-0 rounded-xl p-4" style="background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.sayThis</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">אני כאן. אפשר לעצור רגע. נדבר כשיהיה רגוע יותר.</p><p class="mt-2 text-xs leading-relaxed" style="color:var(--arbor-ink-soft)">בחרו מילים שמתאימות למשפחה. הבטיחו זמן חזרה רק אם תוכלו לעמוד בו.</p></div><div class="min-w-0 rounded-xl p-4" style="background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.avoid</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">אל תנסו לשכנע, לאיים או לדרוש התנצלות באמצע הסערה.</p></div><div class="min-w-0 rounded-xl p-4" style="background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.observe</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">שימו לב מה קרה ממש לפני ומה עזר להתחיל להירגע.</p></div><div class="min-w-0 rounded-xl p-4" role="note" data-testid="hard-moment-escalation" style="background:var(--arbor-green-soft);border:1px solid var(--arbor-rule-strong);border-inline-start:3px solid var(--arbor-green-ink)"><h4 class="text-xs font-bold" style="color:var(--arbor-green-ink)">hm.section.escalation</h4><p class="mt-1 break-words text-base leading-relaxed" style="color:var(--arbor-ink)">אם מישהו בסכנה מיידית, פנו לעזרת חירום מקומית. אם הרגעים האלה נעשים קשים יותר להתמודדות, מובילים לפגיעה או מדאיגים אתכם, שתפו את רופא הילדים במה שקורה לפניהם ואחריהם. אין צורך לחכות למספר מסוים של מקרים.</p></div><details class="min-w-0 text-sm" style="color:var(--arbor-ink-soft)"><summary class="min-h-11 cursor-pointer py-3 font-semibold">מקורות למדריך</summary><ul class="space-y-1"><li><a href="https://www.healthychildren.org/English/family-life/family-dynamics/communication-discipline/Pages/Disciplining-Your-Child.aspx" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 max-w-full items-center break-all py-2 underline">www.healthychildren.org</a></li></ul></details></div>"`;
