exports[`AI-17 — CoachAnswerCards markup is byte-identical across the extraction > renders the Hebrew answer with a council exactly as it shipped 1`] = `"<div class="space-y-2.5"><div class="flex flex-wrap items-center gap-1.5"><span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:var(--arbor-green-soft);color:var(--arbor-green-ink)">מותאם ל-Bowlby&#x27;s Attachment Model</span><span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:var(--arbor-paper-deep);color:var(--arbor-muted)">3-4y</span><span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:var(--arbor-paper-deep);color:var(--arbor-muted)">social emotional</span><span class="text-[10px] font-bold px-2 py-0.5 rounded-full" style="background:var(--arbor-paper-deep);color:var(--arbor-muted)">language communication</span><button type="button" aria-label="How Arbor decides — open the trust center" data-testid="trust-link" class="relative inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[var(--t-xs)] font-bold transition active:scale-[0.97] motion-reduce:transition-none motion-reduce:transform-none before:absolute before:content-[&#x27;&#x27;] before:-inset-y-2 before:inset-x-0" style="background:var(--arbor-lav-soft);color:var(--arbor-lav-ink)">How Arbor decides<span class="msr flex-shrink-0 rtl:rotate-180" aria-hidden="true" style="font-size:13px;font-variation-settings:&#x27;opsz&#x27; 13, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">arrow_forward</span></button></div><div class="rounded-xl p-3.5 bg-white" style="border:1px solid var(--arbor-rule)"><div class="flex items-center justify-between gap-2 mb-2"><span class="inline-flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-wider" style="color:var(--arbor-sky-ink)"><span class="msr" aria-hidden="true" style="font-size:12px;font-variation-settings:&#x27;opsz&#x27; 12, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0