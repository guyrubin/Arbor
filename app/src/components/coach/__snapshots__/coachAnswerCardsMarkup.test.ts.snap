exports[`AI-17 — the unified report's English, Hebrew and escalation markup > renders the Hebrew report with council and bidi isolation 1`] = `"<article class="coach-report" data-testid="coach-answer-cards" dir="rtl"><header class="coach-report__opening" data-testid="coach-report-opening"><div class="coach-report__lead" dir="auto"><p class="leading-relaxed text-sm mb-3.5" style="color:var(--arbor-ink)">Bedtime resistance at this age is usually about separation, not defiance.</p></div></header><section class="coach-report__section coach-report__next" data-testid="coach-report-next"><h3><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">checklist</span>לנסות היום</h3><ol class="coach-report__steps"><li><span class="coach-report__step-number" aria-hidden="true">1</span><div class="coach-report__step-content"><p id="_R_0_-step-0" dir="auto">Start the wind-down fifteen minutes earlier tonight.</p></div></li></ol></section><section class="coach-report__section coach-report__script" id="_R_0_-script"><div data-testid="say-this" class="rounded-xl p-3.5 bg-white" style="border:1px solid var(--arbor-rule)"><div class="flex items-center justify-between gap-2 mb-2"><span class="inline-flex items-center gap-1.5 text-[10px] font-extrabold uppercase tracking-wider" style="color:var(--arbor-sky-ink)"><span class="msr" aria-hidden="true" style="font-size:12px;font-variation-settings:&#x27;opsz&#x27; 12, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">format_quote</span> אפשר להגיד</span><div class="flex items-center gap-2"><button class="text-[10px] font-bold inline-flex min-h-11 items-center gap-1 px-1" style="color:var(--arbor-muted)"><span class="msr" aria-hidden="true" style="font-size:12px;font-variation-settings:&#x27;opsz&#x27; 12, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">content_copy</span> העתקה</button></div></div><p class="t-base leading-relaxed" style="color:var(--arbor-ink);font-family:var(--font-sans);font-style:normal">“I am right here. I will check on you in two minutes.”</p></div></section><section class="coach-report__disclosure" data-testid="coach-report-understanding"><button type="button" id="_R_0_-why-toggle" aria-expanded="false" aria-controls="_R_0_-why"><span>למה זה אולי קורה</span><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">expand_more</span></button><div id="_R_0_-why" role="region" aria-labelledby="_R_0_-why-toggle" hidden="" class="coach-report__disclosure-body"><ul class="coach-report__understanding"><li dir="auto"><strong>Separation at lights-out</strong><p>The protest starts when you leave the room.</p></li><li dir="auto"><strong>Overtired by bedtime</strong><p>The nap dropped three weeks ago.</p></li></ul></div></section><section class="coach-report__disclosure" data-testid="coach-report-details"><button type="button" id="_R_0_-details-toggle" aria-expanded="false" aria-controls="_R_0_-details"><span>צעדים נוספים ודברים לשים לב אליהם</span><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">expand_more</span></button><div id="_R_0_-details" role="region" aria-labelledby="_R_0_-details-toggle" hidden="" class="coach-report__disclosure-body"><section class="coach-report__section"><h4>הצעדים הבאים</h4><ol class="coach-report__steps" start="2"><li><span class="coach-report__step-number" aria-hidden="true">2</span><div class="coach-report__step-content"><p id="_R_0_-step-1" dir="auto">Sit beside the bed for the first two minutes, then step to the doorway.</p></div></li></ol></section><div class="coach-report__considerations"><section class="coach-report__section" data-testid="coach-report-observe"><h4><span class="msr" aria-hidden="true" style="font-size:18px;font-variation-settings:&#x27;opsz&#x27; 18, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">visibility</span>למה לשים לב</h4><ul class="coach-report__list"><li id="_R_0_-observe-0" dir="auto">Whether the protest shortens across the week.</li></ul></section><section class="coach-report__section" data-testid="coach-report-avoid"><h4>ממה להימנע</h4><ul class="coach-report__list"><li dir="auto">Bargaining once the light is off.</li></ul></section></div></div></section><section class="coach-report__disclosure" data-testid="coach-report-help"><button type="button" id="_R_0_-help-toggle" aria-expanded="false" aria-controls="_R_0_-help"><span><span class="msr" aria-hidden="true" style="font-size:17px;font-variation-settings:&#x27;opsz&#x27; 17, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">health_and_safety</span>מתי כדאי לפנות לעזרה</span><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">expand_more</span></button><div id="_R_0_-help" role="region" aria-labelledby="_R_0_-help-toggle" hidden="" class="coach-report__disclosure-body"><ul class="coach-report__list"><li>The night waking is paired with breathing that frightens you.</li></ul></div></section><section class="coach-report__disclosure" data-testid="coach-report-actions"><button type="button" id="_R_0_-actions-toggle" aria-expanded="false" aria-controls="_R_0_-actions"><span>לשמור או להשתמש בתשובה</span><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">expand_more</span></button><div id="_R_0_-actions" role="region" aria-labelledby="_R_0_-actions-toggle" hidden="" class="coach-report__disclosure-body"><div class="coach-report__tools"><button type="button" data-testid="coach-plan-door"><span class="msr" aria-hidden="true" style="font-size:18px;font-variation-settings:&#x27;opsz&#x27; 18, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">playlist_add</span>להפוך לתוכנית</button><button type="button"><span class="msr" aria-hidden="true" style="font-size:17px;font-variation-settings:&#x27;opsz&#x27; 17, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">send</span>פתק למורה</button></div></div></section><section class="coach-report__disclosure" data-testid="coach-report-council"><button type="button" id="_R_0_-council-toggle" aria-expanded="false" aria-controls="_R_0_-council"><span>המועצה התייעצה · 1 קולות</span><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">expand_more</span></button><div id="_R_0_-council" role="region" aria-labelledby="_R_0_-council-toggle" hidden="" class="coach-report__disclosure-body"><ul class="coach-report__understanding"><li dir="auto"><strong>Bowlby</strong><span class="coach-report__meta"> · Secure base</span><p>The check-in IS the secure base.</p><p>Keep the interval predictable.</p></li></ul></div></section><section class="coach-report__disclosure" data-testid="coach-report-sources"><button type="button" id="_R_0_-sources-toggle" aria-expanded="false" aria-controls="_R_0_-sources"><span><span class="msr" aria-hidden="true" style="font-size:17px;font-variation-settings:&#x27;opsz&#x27; 17, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">menu_book</span>מבוסס על 2 מקורות</span><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">expand_more</span></button><div id="_R_0_-sources" role="region" aria-labelledby="_R_0_-sources-toggle" hidden="" class="coach-report__disclosure-body"><ul class="coach-report__source-list"><li><span>Sleep-onset associations</span><span class="coach-report__meta">practice card</span></li><li><span>בהתבסס על: ⁨separation protest⁩</span></li></ul></div></section><footer class="coach-report__footer" data-testid="coach-answer-footer"><div class="coach-report__attribution"><button type="button" aria-label="How Arbor decides — open the trust center" data-testid="trust-link" class="touch-target relative !inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-[var(--t-xs)] font-bold transition active:scale-[0.97] motion-reduce:transition-none motion-reduce:transform-none before:absolute before:content-[&#x27;&#x27;] before:-inset-y-2 before:inset-x-0" style="background:var(--arbor-paper-elevated);border:1px solid var(--arbor-rule);color:var(--arbor-lav-ink)">How Arbor decides<span class="msr flex-shrink-0 rtl:rotate-180" aria-hidden="true" style="font-size:13px;font-variation-settings:&#x27;opsz&#x27; 13, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">arrow_forward</span></button><span>מותאם ל-⁨Bowlby&#x27;s Attachment Model⁩</span><span>גילאי 3–4</span><span>Social emotional</span><span>דיבור והבנה</span></div><div class="coach-report__memory"><div><span class="msr" aria-hidden="true" style="font-size:17px;font-variation-settings:&#x27;opsz&#x27; 17, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">psychology</span><span>מבוסס על 2 עובדות שאישרתם</span><button type="button">ניהול</button></div><button type="button"><span class="msr" aria-hidden="true" style="font-size:17px;font-variation-settings:&#x27;opsz&#x27; 17, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">lightbulb</span>ארבור מציעה לזכור משהו — לבדיקה</button></div><div class="flex flex-wrap items-center gap-x-2 gap-y-1 pt-1"><span class="text-[11px] font-bold" style="color:var(--arbor-muted)">התשובה הזו עזרה לכם?</span><button type="button" aria-pressed="false" aria-label="עזרה" title="עזרה" class="inline-flex items-center gap-1 text-[11px] font-bold px-3 py-1 min-h-11 rounded-full transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1" style="background:var(--arbor-paper-elevated);color:var(--arbor-muted);border:1px solid var(--arbor-rule)"><span class="msr" aria-hidden="true" style="font-size:13px;font-variation-settings:&#x27;opsz&#x27; 13, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">thumb_up</span> עזרה</button><button type="button" aria-pressed="false" aria-label="לא עזרה" title="לא עזרה" class="inline-flex items-center gap-1 text-[11px] font-bold px-3 py-1 min-h-11 rounded-full transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-1" style="background:var(--arbor-paper-elevated);color:var(--arbor-muted);border:1px solid var(--arbor-rule)"><span class="msr" aria-hidden="true" style="font-size:13px;font-variation-settings:&#x27;opsz&#x27; 13, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">thumb_down</span> לא עזרה</button><span class="text-[10px] w-full" style="color:var(--arbor-muted)">המשוב הוא על התשובה, אף פעם לא על הילד שלכם.</span></div></footer></article>"`;

