// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`reduced motion — static phase states > reduced-motion snapshot (listening) 1`] = `"<section tabindex="-1" data-arbor-dialog-layer="true" aria-modal="true" role="dialog" aria-label="Voice conversation with Arbor" dir="ltr" data-phase="listening" data-orb-mode="static" class="fixed inset-x-0 bottom-0 z-40 mx-auto w-full max-w-[640px] rounded-t-[28px] border border-b-0 px-5 pb-6 pt-4" style="background:var(--arbor-paper-elevated);border-color:var(--arbor-rule);box-shadow:var(--shadow-lg)"><div class="flex items-center gap-2"><span class="text-[11px] font-extrabold uppercase tracking-[0.14em]" style="color:var(--arbor-green-ink)">Listening…</span><button type="button" aria-label="End voice conversation" class="touch-target ms-auto flex h-11 w-11 items-center justify-center rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2" style="min-width:var(--touch-min);min-height:var(--touch-min);background:var(--arbor-paper-deep);color:var(--arbor-muted)"><span class="msr" aria-hidden="true" style="font-size:18px;font-variation-settings:&#x27;opsz&#x27; 18, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">close</span></button></div><div class="mt-2 flex flex-col items-center"><div class="relative flex items-center justify-center" style="width:112px;height:112px"><button type="button" disabled="" aria-label="Listening…" class="relative flex h-24 w-24 items-center justify-center rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:cursor-default" style="background:var(--arbor-green-soft);color:var(--arbor-green-ink);border:1px solid var(--arbor-rule-strong)"><span class="msr" aria-hidden="true" style="font-size:34px;font-variation-settings:&#x27;opsz&#x27; 34, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 1;flex-shrink:0">mic</span></button></div></div><div class="mt-3 max-h-28 space-y-1.5 overflow-y-auto text-center"><p dir="auto" aria-live="polite" class="min-h-[1.25rem] text-sm leading-relaxed" style="color:var(--arbor-muted)">what about mornings</p><p dir="auto" aria-live="polite" class="min-h-[1.25rem] text-sm leading-relaxed" style="color:var(--arbor-ink)"></p></div></section>"`;

exports[`reduced motion — static phase states > reduced-motion snapshot (speaking) 1`] = `"<section tabindex="-1" data-arbor-dialog-layer="true" aria-modal="true" role="dialog" aria-label="Voice conversation with Arbor" dir="ltr" data-phase="speaking" data-orb-mode="static" class="fixed inset-x-0 bottom-0 z-40 mx-auto w-full max-w-[640px] rounded-t-[28px] border border-b-0 px-5 pb-6 pt-4" style="background:var(--arbor-paper-elevated);border-color:var(--arbor-rule);box-shadow:var(--shadow-lg)"><div class="flex items-center gap-2"><span class="text-[11px] font-extrabold uppercase tracking-[0.14em]" style="color:var(--arbor-green-ink)">Speaking…</span><button type="button" aria-label="End voice conversation" class="touch-target ms-auto flex h-11 w-11 items-center justify-center rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2" style="min-width:var(--touch-min);min-height:var(--touch-min);background:var(--arbor-paper-deep);color:var(--arbor-muted)"><span class="msr" aria-hidden="true" style="font-size:18px;font-variation-settings:&#x27;opsz&#x27; 18, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">close</span></button></div><div class="mt-2 flex flex-col items-center"><div class="relative flex items-center justify-center" style="width:112px;height:112px"><button type="button" disabled="" aria-label="Speaking…" class="relative flex h-24 w-24 items-center justify-center rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:cursor-default" style="background:var(--arbor-green-soft);color:var(--arbor-green-ink);border:1px solid var(--arbor-rule-strong)"><span class="flex items-end gap-1" aria-hidden="true"><span class="w-1.5 rounded-full" style="height:10px;background:var(--arbor-sage)"></span><span class="w-1.5 rounded-full" style="height:22px;background:var(--arbor-sage)"></span><span class="w-1.5 rounded-full" style="height:30px;background:var(--arbor-sage)"></span><span class="w-1.5 rounded-full" style="height:22px;background:var(--arbor-sage)"></span><span class="w-1.5 rounded-full" style="height:10px;background:var(--arbor-sage)"></span></span></button></div></div><div class="mt-3 max-h-28 space-y-1.5 overflow-y-auto text-center"><p dir="auto" aria-live="polite" class="min-h-[1.25rem] text-sm leading-relaxed" style="color:var(--arbor-muted)"></p><p dir="auto" aria-live="polite" class="min-h-[1.25rem] text-sm leading-relaxed" style="color:var(--arbor-ink)">Keep goodbyes short.</p></div></section>"`;
