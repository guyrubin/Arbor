// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NoticeCard — firewall and direction > snapshot — EN and HE, ask phase 1`] = `"<article data-testid="notice-card" data-milestone-id="cdc-24m-1" data-shelf="words" data-phase="ask" aria-label="Something to notice" class="notice-object notice-object--card arbor-depth-card"><div class="notice-object-identity"><div class="notice-object-heading"><div data-testid="notice-shelf-line" class="notice-object-shelf"><span data-testid="shelf-glyph-duotone" data-shelf="words" data-tint="lav" aria-hidden="true" class="inline-grid flex-none place-items-center" style="width:44px;height:44px;border-radius:var(--r);background:var(--arbor-lav-soft);box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--arbor-lav-ink) 12%, transparent)"><span class="msr" aria-hidden="true" style="font-size:23px;font-variation-settings:&#x27;opsz&#x27; 23, &#x27;wght&#x27; 400, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 1;flex-shrink:0;grid-area:1 / 1;direction:inherit;color:color-mix(in srgb, var(--arbor-lav) 30%, transparent)">chat_bubble</span><span class="msr" aria-hidden="true" style="font-size:23px;font-variation-settings:&#x27;opsz&#x27; 23, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0;grid-area:1 / 1;direction:inherit;color:var(--arbor-lav-ink)">chat_bubble</span></span><p data-testid="notice-shelf" class="t-sm font-semibold">Words</p></div><h3 data-testid="notice-title" class="notice-object-title">Notices others&#x27; feelings</h3></div><img data-testid="notice-area-art" class="notice-object-art" src="/visuals/parent/v1/area-words-480.webp" srcSet="/visuals/parent/v1/area-words-480.webp 1x, /visuals/parent/v1/area-words-960.webp 2x" width="480" height="480" alt="" aria-hidden="true" loading="lazy" decoding="async"/></div><p data-testid="notice-looks" class="notice-object-meaning t-base">Stops and looks concerned when another child is crying.</p><p data-testid="notice-age-line" class="notice-object-source t-sm"><span class="msr" aria-hidden="true" style="font-size:14px;font-variation-settings:&#x27;opsz&#x27; 14, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">menu_book</span><span data-testid="notice-age-text">Most children do this by 2 years</span></p><div class="notice-object-response"><p class="notice-object-prompt t-sm">What have you noticed?</p><div role="group" aria-label="What have you noticed?" data-testid="notice-answers" class="mt-2 flex flex-wrap gap-2"><button type="button" data-answer="yes" aria-pressed="false" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">Seen it</button><button type="button" data-answer="not_yet" aria-pressed="false" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">Not yet</button><button type="button" data-answer="not_sure" aria-pressed="false" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">Not sure</button></div></div></article>"`;

exports[`NoticeCard — firewall and direction > snapshot — EN and HE, ask phase 2`] = `"<article data-testid="notice-card" data-milestone-id="cdc-24m-1" data-shelf="words" data-phase="ask" aria-label="משהו לשים לב אליו" class="notice-object notice-object--card arbor-depth-card"><div class="notice-object-identity"><div class="notice-object-heading"><div data-testid="notice-shelf-line" class="notice-object-shelf"><span data-testid="shelf-glyph-duotone" data-shelf="words" data-tint="lav" aria-hidden="true" class="inline-grid flex-none place-items-center" style="width:44px;height:44px;border-radius:var(--r);background:var(--arbor-lav-soft);box-shadow:inset 0 0 0 1px color-mix(in srgb, var(--arbor-lav-ink) 12%, transparent)"><span class="msr" aria-hidden="true" style="font-size:23px;font-variation-settings:&#x27;opsz&#x27; 23, &#x27;wght&#x27; 400, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 1;flex-shrink:0;grid-area:1 / 1;direction:inherit;color:color-mix(in srgb, var(--arbor-lav) 30%, transparent)">chat_bubble</span><span class="msr" aria-hidden="true" style="font-size:23px;font-variation-settings:&#x27;opsz&#x27; 23, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0;grid-area:1 / 1;direction:inherit;color:var(--arbor-lav-ink)">chat_bubble</span></span><p data-testid="notice-shelf" class="t-sm font-semibold">מילים</p></div><h3 data-testid="notice-title" class="notice-object-title">שמה לב לרגשות של אחרים</h3></div><img data-testid="notice-area-art" class="notice-object-art" src="/visuals/parent/v1/area-words-480.webp" srcSet="/visuals/parent/v1/area-words-480.webp 1x, /visuals/parent/v1/area-words-960.webp 2x" width="480" height="480" alt="" aria-hidden="true" loading="lazy" decoding="async"/></div><p data-testid="notice-looks" class="notice-object-meaning t-base">עוצרת ומסתכלת בדאגה כשילד אחר בוכה.</p><p data-testid="notice-age-line" class="notice-object-source t-sm"><span class="msr" aria-hidden="true" style="font-size:14px;font-variation-settings:&#x27;opsz&#x27; 14, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">menu_book</span><span data-testid="notice-age-text">רוב הילדים עושים זאת עד גיל שנתיים</span></p><div class="notice-object-response"><p class="notice-object-prompt t-sm">מה שמתם לב שקורה?</p><div role="group" aria-label="מה ראיתם?" data-testid="notice-answers" class="mt-2 flex flex-wrap gap-2"><button type="button" data-answer="yes" aria-pressed="false" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">ראיתי</button><button type="button" data-answer="not_yet" aria-pressed="false" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">עוד לא</button><button type="button" data-answer="not_sure" aria-pressed="false" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">לא בטוחים</button></div></div></article>"`;
