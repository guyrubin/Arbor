// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`NoticeCard — firewall and direction > snapshot — EN and HE, ask phase 1`] = `"<article data-testid="notice-card" data-milestone-id="cdc-24m-1" data-shelf="words" data-phase="ask" aria-label="Something to notice" class="rounded-2xl p-4" style="background:var(--arbor-paper-elevated);border:1px solid var(--arbor-rule)"><div class="flex items-start gap-3"><span data-testid="shelf-glyph" data-shelf="words" aria-hidden="true" class="inline-flex flex-none items-center justify-center rounded-xl" style="width:36px;height:36px;background:var(--arbor-lav-soft);color:var(--arbor-lav-ink)"><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">chat_bubble</span></span><div class="min-w-0 flex-1"><p data-testid="notice-shelf" class="t-sm font-semibold" style="color:var(--arbor-muted)">Words</p><h3 data-testid="notice-title" class="mt-0.5 font-semibold leading-tight" style="color:var(--arbor-ink);font-family:var(--font-display);font-size:var(--t-lg)">Notices others&#x27; feelings</h3><p data-testid="notice-looks" class="mt-1 t-base leading-snug" style="color:var(--arbor-ink-soft)">Stops and looks concerned when another child is crying.</p><p data-testid="notice-age-line" class="mt-1.5 flex items-center gap-1.5 t-sm" style="color:var(--arbor-muted)"><span class="msr" aria-hidden="true" style="font-size:14px;font-variation-settings:&#x27;opsz&#x27; 14, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">menu_book</span><span data-testid="notice-age-text">Most children do this by 2 years</span></p><div role="group" aria-label="What have you noticed?" data-testid="notice-answers" class="mt-3 flex flex-wrap gap-2"><button type="button" data-answer="yes" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-clay);background:var(--arbor-paper-elevated);border:1.5px solid var(--arbor-clay)">Seen it</button><button type="button" data-answer="not_yet" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">Not yet</button><button type="button" data-answer="not_sure" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">Not sure</button></div></div></div></article>"`;

exports[`NoticeCard — firewall and direction > snapshot — EN and HE, ask phase 2`] = `"<article data-testid="notice-card" data-milestone-id="cdc-24m-1" data-shelf="words" data-phase="ask" aria-label="משהו לשים לב אליו" class="rounded-2xl p-4" style="background:var(--arbor-paper-elevated);border:1px solid var(--arbor-rule)"><div class="flex items-start gap-3"><span data-testid="shelf-glyph" data-shelf="words" aria-hidden="true" class="inline-flex flex-none items-center justify-center rounded-xl" style="width:36px;height:36px;background:var(--arbor-lav-soft);color:var(--arbor-lav-ink)"><span class="msr" aria-hidden="true" style="font-size:19px;font-variation-settings:&#x27;opsz&#x27; 19, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">chat_bubble</span></span><div class="min-w-0 flex-1"><p data-testid="notice-shelf" class="t-sm font-semibold" style="color:var(--arbor-muted)">מילים</p><h3 data-testid="notice-title" class="mt-0.5 font-semibold leading-tight" style="color:var(--arbor-ink);font-family:var(--font-display);font-size:var(--t-lg)">שמה לב לרגשות של אחרים</h3><p data-testid="notice-looks" class="mt-1 t-base leading-snug" style="color:var(--arbor-ink-soft)">עוצרת ומסתכלת בדאגה כשילד אחר בוכה.</p><p data-testid="notice-age-line" class="mt-1.5 flex items-center gap-1.5 t-sm" style="color:var(--arbor-muted)"><span class="msr" aria-hidden="true" style="font-size:14px;font-variation-settings:&#x27;opsz&#x27; 14, &#x27;wght&#x27; 500, &#x27;GRAD&#x27; 0, &#x27;FILL&#x27; 0;flex-shrink:0">menu_book</span><span data-testid="notice-age-text">רוב הילדים עושים זאת עד גיל שנתיים</span></p><div role="group" aria-label="מה ראיתם?" data-testid="notice-answers" class="mt-3 flex flex-wrap gap-2"><button type="button" data-answer="yes" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-clay);background:var(--arbor-paper-elevated);border:1.5px solid var(--arbor-clay)">ראיתי</button><button type="button" data-answer="not_yet" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">עוד לא</button><button type="button" data-answer="not_sure" class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-full px-4 t-base font-semibold transition active:scale-[0.98]" style="color:var(--arbor-ink);background:var(--arbor-paper-deep);border:1px solid var(--arbor-rule-strong)">לא בטוחים</button></div></div></div></article>"`;
