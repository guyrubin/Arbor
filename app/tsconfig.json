{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  // TEMPORARY: in-flight feature work that predates the arbor-10-capabilities
  // branch and is not yet wired into the app (no tracked file imports these).
  // They depend on modules/exports that don't exist yet (newGames game-round
  // data, growth/competenceLadder, new PracticeEventKind values, ScaffoldState
  // fields), so they fail `tsc --noEmit`. Excluded here to keep lint at zero
  // errors. Remove these entries once the owner finishes the feature.
  "exclude": [
    "src/components/practice/AimMapWorld.tsx",
    "src/components/practice/CourageStepsWorld.tsx",
    "src/components/practice/OrderBuilderWorld.tsx",
    "src/components/practice/PromiseLadderWorld.tsx",
    "src/components/practice/TruthCompassWorld.tsx",
    "src/components/practice/GameScenePanel.tsx",
    "src/components/sections/CompetenceLadderCard.tsx"
  ]
}
