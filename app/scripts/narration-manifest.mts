#!/usr/bin/env tsx
/**
 * B-BOOK-35 / B-BOOK-73 (CI half): writes the kid shelf's narration file
 * manifests (src/content/narrationManifests.json): per shelf book and voice
 * folder (en, he-m, he-f), a sha256 per shipped shared page file, the frozen
 * list of shared page files not rendered yet, and the per-child (name-bearing)
 * files a child's render must produce. Renders nothing and spends nothing:
 * the missing files are the EU render list (Guy's spend).
 *
 *   npx tsx scripts/narration-manifest.mts           # dry run: prints the counts
 *   npx tsx scripts/narration-manifest.mts --write   # rewrites the manifest
 *
 * The missing lists only shrink: a run that would add a missing file is
 * refused (exit 1) unless --init creates the manifest the first time.
 * Checked by src/lib/library/narrationManifest.test.ts.
 */
import { createHash } from "node:crypto";
import { existsSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { shelfNarrationNeeds, type NarrationManifests } from "../src/lib/library/narrationManifest";
import { VOICE_FOLDERS } from "../src/lib/library/narrationFiles";

const APP = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const OUT = path.join(APP, "src", "content", "narrationManifests.json");
const fileOf = (bookId: string, set: string, folder: string, file: string) => path.join(APP, "public", "audio", "books", bookId, set, folder, file);

const write = process.argv.includes("--write");
const init = process.argv.includes("--init");
const previous: NarrationManifests | null = existsSync(OUT) ? JSON.parse(readFileSync(OUT, "utf8")) : null;
if (!previous && !init) { console.error("No manifest yet: run once with --init --write."); process.exit(1); }
if (previous && init) { console.error("The manifest exists: --init would reset the missing lists, refused."); process.exit(1); }

const books: NarrationManifests["books"] = {};
const grown: string[] = [];
for (const need of shelfNarrationNeeds()) {
  const folders = {} as NarrationManifests["books"][string]["folders"];
  for (const folder of VOICE_FOLDERS) {
    const files: Record<string, string> = {};
    const missing: string[] = [];
    for (const file of need.folders[folder].shared) {
      const p = need.set ? fileOf(need.bookId, need.set, folder, file) : null;
      if (p && existsSync(p)) files[file] = createHash("sha256").update(readFileSync(p)).digest("hex");
      else {
        missing.push(file);
        if (previous && !(previous.books[need.bookId]?.folders[folder]?.missing ?? []).includes(file)) grown.push(`${need.bookId}/${folder}/${file}`);
      }
    }
    folders[folder] = { files, missing, perChild: [...need.folders[folder].perChild] };
  }
  books[need.bookId] = { kind: need.kind, set: need.set, folders };
}
if (grown.length) { console.error(`Refused: the missing list would grow:\n  ${grown.join("\n  ")}`); process.exit(1); }
for (const [id, b] of Object.entries(books)) console.log(id.padEnd(28), VOICE_FOLDERS.map((f) => `${f}: ${Object.keys(b.folders[f].files).length} shipped, ${b.folders[f].missing.length} missing, ${b.folders[f].perChild.length} per child`).join(" | "));
const manifest = { _note: "GENERATED by app/scripts/narration-manifest.mts (B-BOOK-35 / B-BOOK-73). Per shelf book and voice folder: sha256 per shipped shared page file, the FROZEN list of shared page files not rendered yet (may only shrink), and the per-child name-bearing files. Checked by src/lib/library/narrationManifest.test.ts.", schema: 1, books };
if (write) writeFileSync(OUT, `${JSON.stringify(manifest, null, 1)}\n`);
